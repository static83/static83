# Claude API (https://platform.claude.com). Required unless you run with --offline.
ANTHROPIC_API_KEY=

# Alpaca PAPER keys (https://app.alpaca.markets, "Paper Trading" tab). Never put live keys here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# SEC EDGAR requires a descriptive User-Agent with contact info.
EDGAR_USER_AGENT=dots-crew your-email@example.com

# Crew settings
DOTS_MODEL=claude-opus-5-5
DOTS_START_BALANCE=37
DOTS_MAX_CANDIDATES=3
DOTS_MAX_ROUNDS=4
DOTS_MIN_MARKET_CAP_USD=300000000
